{
  "name": "@opencrane/ops",
  "version": "0.1.0",
  "private": true,
  "description": "The background workers and operator tools that keep OpenCrane up to date.",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/replay.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "worker": "node --experimental-strip-types src/worker.ts",
    "migrate:model-grants": "node --experimental-strip-types src/migrate-model-grants.ts",
    "migrate:budget-default": "node --experimental-strip-types src/migrate-budget-default.ts"
  },
  "dependencies": {
    "@opencrane/auth": "0.1.0",
    "@opencrane/authz": "0.1.0",
    "@opencrane/event-store": "0.1.0",
    "@opencrane/events": "0.1.0",
    "@opencrane/handlers": "0.1.0",
    "@opencrane/observability": "0.1.0",
    "@opencrane/projections": "0.1.0",
    "@opencrane/models": "0.1.0"
  }
}
