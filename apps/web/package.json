{
  "name": "@opencrane/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The website people use to chat with their assistant and manage an OpenCrane organisation.",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p test/tsconfig.json",
    "test": "ng test",
    "build:live-view-test": "ng build --browser test/live-view-main.ts --ts-config test/tsconfig.live-view.json --output-path dist/live-view"
  },
  "dependencies": {
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@novnc/novnc": "1.5.0",
    "@opencrane/protocol": "0.1.0",
    "punycode": "2.3.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@types/punycode": "2.1.4",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
