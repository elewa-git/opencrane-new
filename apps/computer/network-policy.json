{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "computer"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "computer"
      }
    },
    "policyTypes": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "from": [
          {
            "podSelector": {
              "matchLabels": {
                "app": "opencrane-server"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 8081
          }
        ]
      }
    ],
    "egress": [
      {
        "to": [
          {
            "podSelector": {
              "matchLabels": {
                "app": "opencrane-gateway"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 3000
          }
        ]
      }
    ]
  }
}
