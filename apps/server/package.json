{
  "name": "@opencrane/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OIDC sign-in plus GET /healthz and a WebSocket hello-echo gated on a valid session.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --experimental-strip-types src/main.ts",
    "bootstrap-token": "node --experimental-strip-types src/bootstrap-token.ts",
    "models": "node --experimental-strip-types src/models-main.ts"
  },
  "dependencies": {
    "@opencrane/auth": "0.1.0",
    "@opencrane/authz": "0.1.0",
    "@opencrane/event-store": "0.1.0",
    "@opencrane/events": "0.1.0",
    "@opencrane/models": "0.1.0",
    "@opencrane/observability": "0.1.0",
    "@opencrane/projections": "0.1.0",
    "@opencrane/protocol": "0.1.0",
    "ajv": "8.20.0",
    "cfb": "1.2.2",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.5",
    "file-type": "21.3.4",
    "jose": "6.2.12",
    "minio": "8.0.7",
    "ws": "8.22.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.2",
    "@types/yauzl": "2.10.3",
    "pg": "8.16.3"
  }
}
