download ()
{
    local url="$1";
    local destination="$2";
    local expected_sha256="$3";
    if [ -f "$destination" ] && printf '%s  %s\n' "$expected_sha256" "$destination" | sha256sum --check --status; then
        return;
    fi;
    local partial="${destination}.part";
    curl --fail --location --retry 3 --output "$partial" "$url";
    printf '%s  %s\n' "$expected_sha256" "$partial" | sha256sum --check --status || fail "checksum did not match for $url";
    mv "$partial" "$destination"
}
install_runtime_class ()
{
    kubectl apply -f - <<'EOF'
apiVersion: node.k8s.io/v1
kind: RuntimeClass
metadata:
  name: gvisor
handler: runsc
EOF

}
install_agent_sandbox ()
{
    printf 'Installing Agent Sandbox %s...\n' "$AGENT_SANDBOX_VERSION";
    local manifest="${CACHE_DIR}/agent-sandbox-with-extensions-${AGENT_SANDBOX_VERSION}.yaml";
    download "https://github.com/kubernetes-sigs/agent-sandbox/releases/download/${AGENT_SANDBOX_VERSION}/sandbox-with-extensions.yaml" "$manifest" "$AGENT_SANDBOX_SHA256";
    local controller_image="registry.k8s.io/agent-sandbox/agent-sandbox-controller:${AGENT_SANDBOX_VERSION}";
    [ "$(grep -Fc "image: ${controller_image}" "$manifest")" -eq 1 ] || fail "the verified Agent Sandbox manifest has an unexpected controller image";
    local pinned_manifest="${TEMP_DIR}/agent-sandbox-with-extensions.yaml";
    sed "s|image: ${controller_image}|image: ${controller_image}@${AGENT_SANDBOX_IMAGE_DIGEST}|" "$manifest" > "$pinned_manifest";
    kubectl apply --server-side --field-manager=opencrane-devbox -f "$pinned_manifest" > /dev/null;
    kubectl wait --for=condition=Established --timeout=120s crd/sandboxes.agents.x-k8s.io crd/sandboxclaims.extensions.agents.x-k8s.io crd/sandboxtemplates.extensions.agents.x-k8s.io crd/sandboxwarmpools.extensions.agents.x-k8s.io;
    kubectl rollout status deployment/agent-sandbox-controller --namespace agent-sandbox-system --timeout=180s
}
