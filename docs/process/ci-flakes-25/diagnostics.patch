+async function diagnostic<T>(stage: string, operation: () => Promise<T>): Promise<T> {
+  const started = performance.now();
+  try {
+    return await operation();
+  } catch (error) {
+    const known = ['Authority changed', 'Authority expired', 'Access check expired',
+      'Budget append unavailable', 'Root budget refused', 'Current authority refused',
+      'Current authority unavailable', 'IAM projection behind', 'Event store request timed out'];
+    const failure = error instanceof Error && known.includes(error.message) ? error.message : 'masked';
+    console.error(JSON.stringify({ stage, failure, elapsedMs: Math.round(performance.now() - started),
+      routineRemainingMs: Date.parse('2026-10-11T07:01:00Z') - now }));
+    throw error;
+  }
+}
+function observe<T extends object, K extends keyof T>(target: T, name: K, stage: string) {
+  const original = target[name] as (...args: unknown[]) => Promise<unknown>;
+  async function measured(...args: unknown[]) {
+    return diagnostic(stage, original.bind(target, ...args));
+  }
+  vi.spyOn(target, name as never).mockImplementation(measured as never);
+}
