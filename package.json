{
  "name": "opencrane-2",
  "private": true,
  "type": "module",
  "description": "OpenCrane 2 monorepo: event core, server and supporting libraries.",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "lint": "npm run lint:code && npm run lint:deps && npm run lint:unused && npm run lint:docs && npm run lint:links && npm run lint:fixtures",
    "typecheck": "npm run typecheck --workspaces",
    "pretest": "sh scripts/fetch-nats.sh && bash spikes/s0-1c-real-model-smoke/scripts/fetch-tools.sh",
    "test": "vitest run",
    "replay": "npm run start -w apps/ops --",
    "check:events": "node --experimental-strip-types scripts/check-event-catalogue.mjs",
    "visual:org-admin": "node scripts/capture-org-admin.mjs",
    "lint:code": "eslint .",
    "lint:deps": "depcruise apps/computer/src apps/ops/src apps/server/src apps/web/src libs --config .dependency-cruiser.cjs",
    "lint:unused": "knip",
    "lint:docs": "markdownlint-cli2",
    "lint:links": "sh scripts/fetch-lychee.sh && .tools/lychee --offline --include-fragments '*.md' 'docs/**/*.md' 'apps/*/README.md' 'libs/*/README.md'",
    "provision": "node --experimental-strip-types libs/handlers/src/provision.ts",
    "visual:signin": "node scripts/capture-signin.mjs",
    "lint:fixtures": "python3 infra/odoo/boundary.py",
    "visual:chat": "NO_COLOR=1 node scripts/check-chat-browser.mjs --capture",
    "test:chat:production": "NO_COLOR=1 node scripts/check-chat-production.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "knip": "6.39.0",
    "markdownlint-cli2": "0.23.3",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@openfga/sdk": {
      "axios": "1.20.0"
    }
  }
}
