{
  "name": "s0-7-jetstream-spike",
  "private": true,
  "version": "0.0.0",
  "description": "Spike S0.7: can NATS JetStream be OpenCrane 2's event store?",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --pool=forks --reporter=verbose",
    "test:1": "vitest run tests/01-conditional-append.test.ts --reporter=verbose",
    "test:2": "vitest run tests/02-ordered-replay.test.ts --reporter=verbose",
    "test:3": "vitest run tests/03-rebuild-by-replay.test.ts --reporter=verbose",
    "test:4": "vitest run tests/04-r3-failover.test.ts --reporter=verbose",
    "test:5": "vitest run tests/05-scale-1m.test.ts --reporter=verbose",
    "test:6": "vitest run tests/06-backup-restore.test.ts --reporter=verbose",
    "test:7": "vitest run tests/07-dedup-lost-on-restore.test.ts --reporter=verbose",
    "all": "npm run test"
  },
  "dependencies": {
    "@nats-io/transport-node": "3.4.0",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "@electric-sql/pglite": "0.5.8"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@types/node": "26.6.3"
  }
}
