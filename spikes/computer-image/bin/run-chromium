#!/bin/sh
# Waits for the X display, then runs Chromium (Playwright's build) on it.
#  --no-sandbox : Chromium's own sandbox needs kernel features that gVisor and most containers do not give;
#      the isolation here comes from gVisor and the Pod instead. --test-type hides the matching warning bar.
#  --remote-debugging-port : Playwright MCP attaches here (127.0.0.1 only).
#  --disable-dev-shm-usage : use /tmp instead of the small /dev/shm.
set -eu
i=0
while [ ! -S /tmp/.X11-unix/X1 ] && [ "$i" -lt 60 ]; do i=$((i + 1)); sleep 0.5; done
[ -S /tmp/.X11-unix/X1 ] || { echo "X display :1 did not appear"; exit 1; }
PROFILE="$HOME/.config/chromium-profile"
mkdir -p "$PROFILE"
# After a restart the old lock files point at a process that no longer exists.
rm -f "$PROFILE/SingletonLock" "$PROFILE/SingletonCookie" "$PROFILE/SingletonSocket"
exec /usr/local/bin/chromium \
  --no-sandbox --test-type \
  --disable-background-networking --disable-component-update --disable-sync \
  --disable-gpu --disable-dev-shm-usage \
  --user-data-dir="$PROFILE" \
  --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 \
  --no-first-run --no-default-browser-check --password-store=basic \
  --window-position=0,0 --window-size=1280,800 --start-maximized \
  about:blank
