{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/.tools/**"
  ],
  "workspaces": {
    ".": {
      "entry": [],
      "project": [
        "scripts/**/*.mjs",
        "*.mjs"
      ]
    },
    "apps/server": {
      "entry": [
        "test/**/*.test.ts",
        "test/support/process-faults.ts",
        "test/support/ephemeral-ports.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "apps/ops": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/**/*.spec.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreDependencies": [
        "@fontsource/dm-mono",
        "@fontsource/dm-sans"
      ]
    },
    "libs/auth": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "libs/events": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "libs/observability": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "libs/protocol": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "libs/event-store": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "libs/projections": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "libs/handlers": {
      "entry": [
        "test/**/*.test.ts",
        "test/crash-process.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "libs/authz": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "apps/computer": {
      "entry": [
        "src/entrypoint.ts",
        "src/bridge.ts",
        "src/desktop.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreBinaries": [
        "codex",
        "kasmvncpasswd",
        "Xvnc",
        "setpriv",
        "kubectl"
      ]
    }
  }
}
