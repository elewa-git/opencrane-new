model
  schema 1.1

type person

type assistant
  relations
    define acts_for: [person, team#member]

type silo
  relations
    define member: [person]
    define owner_role: [person]
    define admin_role: [person]
    define owner: owner_role and member
    define admin: (admin_role or owner_role) and member

# Internal receipt, written atomically with the event's member tuples.
type projection_event
  relations
    define applied: [silo]

# Personal conversation content stays private even from silo administrators.
type conversation
  relations
    define silo: [silo]
    define participant: [person]
    define creator: [person]
    define read: participant and member from silo
    define post: read
    define manage_participants: creator and read

# Explicit resource grants never follow from installation or ownership.
type resource
  relations
    define use: [person, assistant, team#member]

type team
  relations
    define member: [person]

# Provider configuration grants no model use; management follows current silo roles.
type provider
  relations
    define silo: [silo]
    define manage: admin from silo
    define read: manage

# Keep retired metadata readable while removing management permission.
type routine
  relations
    define silo: [silo]
    define active_silo: [silo]
    define owner: [person]
    define read_metadata: (owner or admin from silo) and member from silo
    define manage: owner and member from active_silo
